new file mode 100644
index 0000000..77b9cb4
--- /dev/null
+++ b/scrapydweb/templates/scrapydweb/spider_logs.html
@@ -0,0 +1,89 @@
+{% extends 'base.html' %}
+
+{% block title %}{{ title }}{% endblock %}
+
+{% block head %}
+  <style>
+    .spider-logs h3 {margin: 24px 0 8px;}
+    .spider-logs table {border-collapse: collapse; width: 100%; font-size: 14px;}
+    .spider-logs th, .spider-logs td {border-bottom: 1px solid #ebeef5; padding: 8px 10px; text-align: left;}
+    .spider-logs th {color: #909399; font-weight: 500;}
+    .spider-logs td:last-child {white-space: nowrap;}
+    .spider-logs td.job {font-family: monospace; font-size: 12px; color: #606266;}
+    .spider-logs a.btn {display: inline-block; padding: 2px 8px; margin-right: 4px; border-radius: 3px;
+                        color: #fff; background: #409EFF; font-size: 12px;}
+    .spider-logs a.btn.stats {background: #67C23A;}
+    .spider-logs a.btn.raw {background: #909399;}
+    .spider-logs .empty {color: #909399;}
+    .spider-logs .errors {color: #F56C6C;}
+    .spider-logs .search input {font-size: 16px; padding: 6px 10px; width: 320px;}
+    .spider-logs .search button {font-size: 16px; padding: 6px 14px;}
+  </style>
+{% endblock %}
+
+{% macro jobs_table(rows, time_label, time_key) %}
+  <table>
+    <tr>
+      <th>Node</th><th>Project</th><th>Job</th><th>Start</th>{% if time_key %}<th>{{ time_label }}</th>{% endif %}<th>Logs</th>
+    </tr>
+    {% for row in rows %}
+    <tr>
+      <td><a href="{{ row.url_jobs }}" title="{{ row.server }}">{{ row.node }}. {{ row.server }}{% if row.group %} ({{ row.group }}){% endif %}</a></td>
+      <td>{{ row.project }}</td>
+      <td class="job">{{ row.job }}</td>
+      <td>{{ row.start_time }}</td>
+      {% if time_key %}<td>{{ row[time_key] }}</td>{% endif %}
+      <td>
+        <a class="btn" href="{{ row.url_utf8 }}" target="_blank">Log</a>
+        <a class="btn stats" href="{{ row.url_stats }}" target="_blank">Stats</a>
+        <a class="btn raw" href="{{ row.url_raw }}" target="_blank">Raw</a>
+      </td>
+    </tr>
+    {% endfor %}
+  </table>
+{% endmacro %}
+
+{% block body %}
+<div class="spider-logs">
+  <h2>Spider Logs Search</h2>
+  <p class="empty">Running job and last finished jobs of a spider on all {{ SCRAPYD_SERVERS_AMOUNT }} nodes.</p>
+  <form class="search" method="get" action="{{ url_for('spiderlogs', node=node) }}">
+    <input type="text" name="spider" value="{{ spider }}" placeholder="spider name, e.g. darty_fr" autofocus>
+    <button type="submit">Find</button>
+  </form>
+
+{% if spider %}
+  {% if errors %}
+  <div class="errors">
+    <h3>Unreachable nodes</h3>
+    {% for error in errors %}
+    <div>{{ error.node }}. {{ error.server }}: {{ error.message }}</div>
+    {% endfor %}
+  </div>
+  {% endif %}
+
+  <h3>Running</h3>
+  {% if running %}{{ jobs_table(running, '', '') }}{% else %}<p class="empty">{{ spider }} is not running on any node.</p>{% endif %}
+
+  {% if pending %}
+  <h3>Pending</h3>
+  {{ jobs_table(pending, '', '') }}
+  {% endif %}
+
+  <h3>Last finished</h3>
+  {% if last_finished %}{{ jobs_table(last_finished, 'Finish', 'end_time') }}{% else %}<p class="empty">No finished job of {{ spider }} on any node.</p>{% endif %}
+
+  {% if older_finished %}
+  <h3>Earlier finished</h3>
+  {{ jobs_table(older_finished, 'Finish', 'end_time') }}
+  {% endif %}
+
+  {% if not running and not pending and not last_finished and other_spiders %}
+  <h3>Did you mean</h3>
+  {% for name in other_spiders %}
+    <a href="{{ url_for('spiderlogs', node=node, spider=name) }}">{{ name }}</a>{% if not loop.last %}, {% endif %}
+  {% endfor %}
+  {% endif %}
+{% endif %}
+</div>
+{% endblock %}
