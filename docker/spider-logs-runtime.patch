diff --git a/scrapydweb/views/files/spider_logs.py b/scrapydweb/views/files/spider_logs.py
new file mode 100644
index 0000000..05c7071
--- /dev/null
+++ b/scrapydweb/views/files/spider_logs.py
@@ -0,0 +1,132 @@
+# coding: utf-8
+"""Find the logs of a spider on all Scrapyd nodes.
+
+A load balancer moves jobs between nodes, so the job of a given spider may be running on one node
+while its previous run finished on another. This view asks every node for its jobs and returns
+the running jobs of the spider plus its most recently finished ones, with links to their logs.
+
+Scrapyd keeps only its last `finished_to_keep` jobs in memory and forgets them on restart, so finished
+jobs are also read from the jobs tables of ScrapydWeb's own database (filled by the Jobs page snapshots).
+"""
+from concurrent.futures import ThreadPoolExecutor
+
+from flask import render_template, request, url_for
+from sqlalchemy import func
+
+from ...vars import jobs_table_map
+from ..dashboard.jobs import STATUS_FINISHED
+from ..baseview import BaseView
+
+
+class SpiderLogsView(BaseView):
+    methods = ['GET']
+
+    FINISHED_TO_SHOW = 5
+
+    def __init__(self):
+        super(SpiderLogsView, self).__init__()
+        self.spider = request.args.get('spider', '').strip()
+        self.template = 'scrapydweb/spider_logs.html'
+
+    def dispatch_request(self, **kwargs):
+        running, pending, finished, errors, other_spiders = [], [], [], [], set()
+        if self.spider:
+            with ThreadPoolExecutor(max_workers=min(16, self.SCRAPYD_SERVERS_AMOUNT)) as executor:
+                results = executor.map(self.fetch_node_jobs, range(1, self.SCRAPYD_SERVERS_AMOUNT + 1))
+            for node, jobs, node_errors in results:
+                errors.extend(node_errors)
+                for job in jobs:
+                    if job['spider'].lower() != self.spider.lower():
+                        if self.spider.lower() in job['spider'].lower():
+                            other_spiders.add(job['spider'])
+                        continue
+                    row = self.make_row(node, job)
+                    {'running': running, 'pending': pending, 'finished': finished}[job['state']].append(row)
+            seen = set((row['node'], row['project'], row['job']) for row in running + pending + finished)
+            for row in self.query_finished_from_db():
+                if (row['node'], row['project'], row['job']) not in seen:
+                    finished.append(row)
+
+        running.sort(key=lambda row: row['start_time'], reverse=True)
+        finished.sort(key=lambda row: row['end_time'], reverse=True)
+        kwargs = dict(
+            node=self.node,
+            title='spider logs search',
+            spider=self.spider,
+            running=running,
+            pending=pending,
+            last_finished=finished[:1],
+            older_finished=finished[1:self.FINISHED_TO_SHOW],
+            errors=errors,
+            other_spiders=sorted(other_spiders),
+        )
+        return render_template(self.template, **kwargs)
+
+    def query_finished_from_db(self):
+        """Finished jobs of the spider recorded by ScrapydWeb's Jobs snapshots, newest first per node."""
+        rows = []
+        for node in range(1, self.SCRAPYD_SERVERS_AMOUNT + 1):
+            Job = jobs_table_map.get(node)
+            if Job is None:
+                continue
+            try:
+                records = (Job.query
+                           .filter(func.lower(Job.spider) == self.spider.lower(), Job.status == STATUS_FINISHED)
+                           .order_by(Job.finish.desc())
+                           .limit(self.FINISHED_TO_SHOW)
+                           .all())
+            except Exception as err:  # e.g. table not created yet
+                self.logger.error("Fail to query finished jobs of node %s: %s", node, err)
+                continue
+            for record in records:
+                job = dict(
+                    project=record.project,
+                    spider=record.spider,
+                    id=record.job,
+                    start_time=str(record.start or ''),
+                    end_time=str(record.finish or ''),
+                    log_url=record.href_log or '',
+                )
+                rows.append(self.make_row(node, job))
+        return rows
+
+    def fetch_node_jobs(self, node):
+        """Return (node, jobs, errors) where jobs is a list of dicts with a 'state' and 'project' key."""
+        server = self.SCRAPYD_SERVERS[node - 1]
+        auth = self.SCRAPYD_SERVERS_AUTHS[node - 1]
+        status_code, js = self.make_request('http://%s/listprojects.json' % server, auth=auth, timeout=10)
+        if status_code != 200 or js.get('status') != self.OK:
+            return node, [], [dict(node=node, server=server, message=js.get('message', status_code))]
+
+        jobs, errors = [], []
+        for project in js.get('projects', []):
+            url = 'http://%s/listjobs.json?project=%s' % (server, project)
+            status_code, js_jobs = self.make_request(url, auth=auth, timeout=10)
+            if status_code != 200 or js_jobs.get('status') != self.OK:
+                errors.append(dict(node=node, server=server, message=js_jobs.get('message', status_code)))
+                continue
+            for state in ('running', 'pending', 'finished'):
+                for job in js_jobs.get(state, []):
+                    jobs.append(dict(job, state=state, project=project))
+        return node, jobs, errors
+
+    def make_row(self, node, job):
+        server = self.SCRAPYD_SERVERS[node - 1]
+        public_url = self.SCRAPYD_SERVERS_PUBLIC_URLS[node - 1] or 'http://%s' % server
+        log_url = job.get('log_url') or '/logs/%s/%s/%s.log' % (job['project'], job['spider'], job['id'])
+        return dict(
+            node=node,
+            server=server,
+            group=self.SCRAPYD_SERVERS_GROUPS[node - 1] if len(self.SCRAPYD_SERVERS_GROUPS) >= node else '',
+            project=job['project'],
+            spider=job['spider'],
+            job=job['id'],
+            start_time=(job.get('start_time') or '')[:19],
+            end_time=(job.get('end_time') or '')[:19],
+            url_utf8=url_for('log', node=node, opt='utf8', project=job['project'],
+                             spider=job['spider'], job=job['id']),
+            url_stats=url_for('log', node=node, opt='stats', project=job['project'],
+                              spider=job['spider'], job=job['id']),
+            url_raw=public_url + log_url,
+            url_jobs=url_for('jobs', node=node),
+        )
